---
import { formatCategory } from "@utils/category";
import { getCategoryList } from "@utils/content";
import { widgetManager, getComponentConfig } from "@utils/widget";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { Icon } from "astro-icon/components";
import WidgetLayout from "./widgetLayout.astro";


const categories = await getCategoryList();

const COLLAPSED_HEIGHT = "7.5rem";

// 使用统一的组件管理器检查是否应该折叠
const categoriesComponent = getComponentConfig("categories");
const isCollapsed = categoriesComponent ? widgetManager.isCollapsed(categoriesComponent, categories.length) : false;

interface Props {
    class?: string;
    style?: string;
    side?: string;
}
const { class: className, style, side = "default" } = Astro.props;
---

<WidgetLayout
    name={i18n(I18nKey.categories)}
    id={`categories-${side}`}
    isCollapsed={isCollapsed}
    collapsedHeight={COLLAPSED_HEIGHT}
    class={className}
    style={style}
>
    <category-tree>
        {categories.map((c) => {
            const fullDisplayName = formatCategory(c.fullPath) || c.name.trim();

            return (
                <div
                    class:list={["category-item", { hidden: c.level > 0 }]}
                    data-category-item
                    data-category-path={c.fullPath}
                    data-parent-path={c.parentPath}
                    data-level={String(c.level)}
                >
                    <div
                        class="group flex items-center gap-2 rounded-lg transition-colors hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active)"
                        style={`padding-left: ${c.level * 0.85}rem`}
                    >
                        {c.hasChildren ? (
                            <button
                                type="button"
                                class="category-toggle flex h-10 w-8 shrink-0 items-center justify-center rounded-lg text-50 transition hover:text-(--primary)"
                                data-category-toggle
                                aria-expanded="false"
                                aria-label={`Toggle ${fullDisplayName} subcategories`}
                            >
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="text-xl transition-transform"
                                    data-category-toggle-icon
                                />
                            </button>
                        ) : (
                            <span class="inline-block h-10 w-8 shrink-0"></span>
                        )}
                        <a
                            href={c.url}
                            aria-label={`View all posts in the ${fullDisplayName} category`}
                            class="flex min-w-0 flex-1 items-center py-2 text-left text-neutral-700 transition group-hover:text-(--primary) dark:text-neutral-300 dark:group-hover:text-(--primary)"
                        >
                            <span class="overflow-hidden text-ellipsis whitespace-nowrap">
                                {c.name.trim()}
                            </span>
                        </a>
                        <div
                            class="mr-2 flex h-7 min-w-8 items-center justify-center rounded-lg bg-[oklch(0.95_0.025_var(--hue))] px-2 text-sm font-bold text-(--btn-content) transition dark:bg-(--primary) dark:text-(--deep-text)"
                        >
                            {String(c.count)}
                        </div>
                    </div>
                </div>
            );
        })}
    </category-tree>
</WidgetLayout>

<script>
    class CategoryTree extends HTMLElement {
        connectedCallback() {
            this.addEventListener("click", this.handleToggleClick);
            this.syncVisibility();
        }

        disconnectedCallback() {
            this.removeEventListener("click", this.handleToggleClick);
        }

        handleToggleClick = (event: MouseEvent) => {
            const target = event.target;
            if (!(target instanceof Element)) {
                return;
            }

            const button = target.closest("[data-category-toggle]");
            if (!(button instanceof HTMLButtonElement) || !this.contains(button)) {
                return;
            }

            const isExpanded = button.getAttribute("aria-expanded") === "true";
            button.setAttribute("aria-expanded", String(!isExpanded));
            this.syncVisibility();
        };

        syncVisibility() {
            const items = Array.from(this.querySelectorAll("[data-category-item]"));

            items.forEach((item) => {
                if (!(item instanceof HTMLElement)) {
                    return;
                }

                item.classList.toggle("hidden", !this.isItemVisible(item));

                const toggle = item.querySelector("[data-category-toggle]");
                const icon = item.querySelector("[data-category-toggle-icon]");

                if (toggle instanceof HTMLElement && icon instanceof HTMLElement) {
                    icon.classList.toggle(
                        "rotate-90",
                        toggle.getAttribute("aria-expanded") === "true",
                    );
                }
            });
        }

        isItemVisible(item: HTMLElement) {
            const level = Number(item.dataset.level || 0);
            if (level === 0) {
                return true;
            }

            let parentPath = item.dataset.parentPath || "";

            while (parentPath) {
                const parentItem = this.querySelector(
                    `[data-category-item][data-category-path="${CSS.escape(parentPath)}"]`,
                );

                if (!(parentItem instanceof HTMLElement)) {
                    return false;
                }

                const toggle = parentItem.querySelector("[data-category-toggle]");
                if (toggle instanceof HTMLElement && toggle.getAttribute("aria-expanded") !== "true") {
                    return false;
                }

                parentPath = parentItem.dataset.parentPath || "";
            }

            return true;
        }
    }

    if (!customElements.get("category-tree")) {
        customElements.define("category-tree", CategoryTree);
    }
</script>
